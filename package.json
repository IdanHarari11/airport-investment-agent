{
  "name": "airport-investment-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
