# Required for chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional completion budget (default 16384 in code). Values below 4096 are ignored
# so structured AgentResponse JSON can finish (avoid "length limit was reached").
# OPENAI_MAX_TOKENS=16384

# Optional LangSmith tracing (app works without these)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airport-investment-agent

# Voice output (ElevenLabs TTS) — optional; required only for Play audio / speaker button
ELEVENLABS_API_KEY=
# Optional overrides
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
