# Required for chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional LangSmith tracing (app works without these)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airport-investment-agent

# Voice output (ElevenLabs TTS) — optional; required only for Play audio / speaker button
ELEVENLABS_API_KEY=
# Optional overrides
